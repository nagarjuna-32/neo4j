# DevGraph Sentinel Environment Configuration Example
# Copy this file to .env and adjust variables as needed

# Server Configuration
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=info

# Neo4j Database Configuration (AuraDB or local instance)
# For AuraDB: neo4j+s://<dbid>.databases.neo4j.io
# For Local: neo4j://localhost:7687 or bolt://localhost:7687
NEO4J_URI=neo4j+s://demo.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your_secure_neo4j_password_here
NEO4J_DATABASE=neo4j

# OpenAI API Configuration
# Optional: if absent, DevGraph Sentinel uses deterministic evidence-grounded fallback reasoning
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4.1-mini
OPENAI_TEMPERATURE=0.2
OPENAI_MAX_TOKENS=1000
